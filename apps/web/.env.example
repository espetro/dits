# Copy to apps/web/.env.local (or apps/web/.env) when needed. All optional.

# Base URL of the di server. Empty = same-origin (or fully client-only).
# Points the health probe (VITE_DI_API_BASE/api/health) and server-driver
# websocket/fetch calls. Example against a locally running di server:
# VITE_DI_API_BASE=http://localhost:9000/v1

# Pin the voice driver to the browser implementation (Web Speech + client-side
# agent loop), skipping the /api/health probe:
# VITE_VOICE_DEFAULT=browser

# Demo endpoint for the one-click "Demo API" fill in settings -> llm. Baked
# into the bundle at build time; unset = the demo affordance stays hidden.
# Browser calls must come from an origin the endpoint's allowlist accepts.
# VITE_DEMO_LLM_BASE_URL=
# VITE_DEMO_LLM_API_KEY=
# VITE_DEMO_LLM_MODEL=

# ── Voice pipeline tuning (browser mode) ───────────────────
# Every knob falls back to the default shown; set when evals or hardware need
# different headroom. Build-time only (Vite inlines them).

# vad endpointing (interview cadence): silence grace before a turn ends, the
# silero speech hysteresis pair, and minimum utterance length. Too low clips
# mid-sentence pauses; too high adds dead air before every turn.
# VITE_VAD_REDEMPTION_MS=600
# VITE_VAD_POSITIVE_SPEECH_THRESHOLD=0.5
# VITE_VAD_NEGATIVE_SPEECH_THRESHOLD=0.35
# VITE_VAD_MIN_SPEECH_MS=250

# barge-in / echo gate (browser driver): sustained high-prob vad frames during
# playback earn the interrupt; the tail keeps room echo out after drain.
# VITE_VOICE_BARGE_IN_PROB=0.85
# VITE_VOICE_BARGE_IN_FRAMES=2
# VITE_VOICE_BARGE_IN_GRACE_MS=300
# VITE_VOICE_ECHO_GATE_TAIL_MS=350
# VITE_VOICE_MIN_CONFIDENCE=0.6

# timeouts and reconnect backoff.
# VITE_VOICE_TTS_SENTENCE_TIMEOUT_MS=15000
# VITE_VOICE_LLM_TURN_TIMEOUT_MS=90000
# VITE_VOICE_WS_OPEN_TIMEOUT_MS=10000
# VITE_VOICE_RPC_TIMEOUT_MS=120000
# VITE_VOICE_RECONNECT_BASE_MS=1000
# VITE_VOICE_RECONNECT_CAP_MS=15000

# observability ring + mic/agent level decay.
# VITE_VOICE_HEALTH_CAP=300
# VITE_VOICE_LEVEL_RELEASE_MS=220
