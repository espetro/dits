# Copy to apps/web/.env.local (or apps/web/.env) when needed. All optional.

# Base URL of the di server. Empty = same-origin (or fully client-only).
# Points the health probe (VITE_DI_API_BASE/api/health) and server-driver
# websocket/fetch calls. Example against a locally running di server:
# VITE_DI_API_BASE=http://localhost:9000/v1

# Pin the voice driver to the browser implementation (Web Speech + client-side
# agent loop), skipping the /api/health probe:
# VITE_VOICE_DEFAULT=browser

# Demo endpoint for the one-click "Demo API" fill in settings -> llm. Baked
# into the bundle at build time; unset = the demo affordance stays hidden.
# Browser calls must come from an origin the endpoint's allowlist accepts.
# VITE_DEMO_LLM_BASE_URL=
# VITE_DEMO_LLM_API_KEY=
# VITE_DEMO_LLM_MODEL=
